{
    "name":  "dsh-manual-compact-plugin",
    "version":  "0.1.2",
    "description":  "Manual context compaction for DeepSeek Harness: keep the latest N conversation items with stop or batch mode and a per-session compaction archive 鈥?embedded in the context meter popup when the meter panel slot exists, or a composer button otherwise.",
    "type":  "module",
    "main":  "lib/index.js",
    "exports":  {
                    ".":  "./lib/index.js",
                    "./client":  "./lib/client.js",
                    "./package.json":  "./package.json"
                },
    "files":  [
                  "lib",
                  "cordis.patch.yml",
                  "README.md"
              ],
    "keywords":  [
                     "deepseek-harness",
                     "dsh",
                     "dsh-plugin",
                     "cordis",
                     "compaction",
                     "context",
                     "archive"
                 ],
    "license":  "MIT",
    "dsh":  {
                "bundle":  {
                               "patch":  "./cordis.patch.yml"
                           },
                "client":  {
                               "inject":  [
                                              "@deepseek-ai/dsh-client-ui-conversation",
                                              "@deepseek-ai/dsh-client-ui-settings"
                                          ],
                               "platform":  "web"
                           }
            },
    "peerDependencies":  {
                             "@deepseek-ai/cordis":  "^4.0.1",
                             "@deepseek-ai/dsh-agent":  "^0.1.1-rc.1",
                             "@deepseek-ai/dsh-settings":  "^0.1.1-rc.1",
                             "@deepseek-ai/dsh-client-ui-conversation":  "^0.1.1-rc.1",
                             "@deepseek-ai/schemastery":  "^3.18.1",
                             "react":  "^18.2.0"
                         },
    "peerDependenciesMeta":  {
                                 "@deepseek-ai/dsh-client-ui-conversation":  {
                                                                                 "optional":  true
                                                                             },
                                 "react":  {
                                               "optional":  true
                                           }
                             },
    "repository":  {
                       "type":  "git",
                       "url":  "git+https://github.com/kimkingyu/dsh-manual-compact.git"
                   },
    "homepage":  "https://github.com/kimkingyu/dsh-manual-compact#readme",
    "bugs":  {
                 "url":  "https://github.com/kimkingyu/dsh-manual-compact/issues"
             },
    "publishConfig":  {
                          "access":  "public"
                      }
}
